APP_NAME="KIRH GEO"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
CORS_ALLOWED_ORIGINS=http://localhost:18081,http://localhost:5173

APP_LOCALE=ru
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=15432
DB_DATABASE=kirh_geo_dev
DB_USERNAME=kirh_test
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Realtime. Generate unique values per environment; expose only REVERB_APP_KEY to clients.
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=localhost
REVERB_PORT=443
REVERB_SCHEME=https

# Push provider credentials must remain outside the repository.
FCM_CREDENTIALS_PATH=
APNS_CERTIFICATE_PATH=
APNS_KEY_PATH=
APNS_KEY_PASSWORD=
APNS_TOPIC=ru.kirh.geo
APNS_SANDBOX=true

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Requires SMTP and an HTTPS page that processes fragment actions without third-party resources.
IDENTITY_MAIL_ACTIONS_ENABLED=false
IDENTITY_ACTION_URL=

# Commercial providers are fail-closed until configured and accepted in sandbox.
BILLING_RENEWALS_ENABLED=false
BILLING_SANDBOX_ENABLED=false
BILLING_SANDBOX_WEBHOOK_SECRET=
YOOKASSA_ENABLED=false
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET=
YOOKASSA_RETURN_URL=
APPLE_BUNDLE_ID=ru.kirh.geo
APPLE_ISSUER_ID=
APPLE_KEY_ID=
GOOGLE_PLAY_PACKAGE_NAME=ru.kirh.geo

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
